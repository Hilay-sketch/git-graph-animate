{
  "name": "@gamzo/git-graph",
  "version": "0.1.3",
  "description": "Draw pretty git graphs with React",
  "license": "MIT",
  "homepage": "https://gitgraph-showcase.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilay-sketch/gitgraph.js.git"
  },
  "bugs": {
    "url": "https://github.com/Hilay-sketch/gitgraph.js/issues"
  },
  "keywords": [
    "react",
    "git",
    "graph"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --globals",
    "format": "prettier --write src",
    "prepare": "npm run build",
    "knip": "knip",
    "example": "vite example",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4"
  },
  "packageManager": "pnpm@11.17.0"
}
