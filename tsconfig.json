{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "target": "es2019",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react",
    "lib": [
      "dom",
      "es2019"
    ],
    "types": [
      "vitest/globals"
    ],
    "declaration": true,
    "strict": true,
    "isolatedModules": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/__tests__"
  ]
}
